@model ChainMarket.Web.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Завършване на поръчката";
}

<section class="catalog-page">

    <header class="catalog-header">
        <h1>Завършване на поръчката</h1>
        <p>Въведете вашите данни за доставка.</p>
    </header>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <form asp-controller="Checkout"
                  asp-action="Index"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CustomerName" class="form-label"></label>
                    <input asp-for="CustomerName"
                           class="form-control"
                           autocomplete="name" />
                    <span asp-validation-for="CustomerName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="email" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone"
                           class="form-control"
                           autocomplete="tel" />
                    <span asp-validation-for="Phone"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="DeliveryAddress" class="form-label"></label>
                    <textarea asp-for="DeliveryAddress"
                              class="form-control"
                              rows="3"
                              autocomplete="street-address"></textarea>
                    <span asp-validation-for="DeliveryAddress"
                          class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between gap-3 flex-wrap">

                    <a asp-controller="ShoppingCart"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        ← Обратно към количката
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Потвърди поръчката
                    </button>

                </div>

            </form>

        </div>
    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
