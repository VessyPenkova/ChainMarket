@model ChainMarket.Web.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Завършване на поръчката";
}

<section class="catalog-page">

    <header class="catalog-header">
        <h1>Завършване на поръчката</h1>
        <p>Въведете вашите данни за доставка.</p>
    </header>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <form asp-controller="Checkout" asp-action="Index" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="CustomerType" class="form-label"></label>

                    <select asp-for="CustomerType" class="form-select" id="CustomerType">

                        <option value="Individual">Физическо лице</option>
                        <option value="Company">Юридическо лице</option>

                    </select>

                    <span asp-validation-for="CustomerType" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerName" class="form-label"></label>
                    <input asp-for="CustomerName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="CustomerName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="DeliveryAddress" class="form-label"></label>
                    <textarea asp-for="DeliveryAddress" class="form-control" rows="3" autocomplete="street-address"></textarea>
                    <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                </div>


                <div id="companyInvoiceFields" hidden>

                    <h2 class="h5 mb-3">Данни за фактура</h2>

                    <div class="mb-3">
                        <label asp-for="CompanyName" class="form-label"></label>
                        <input asp-for="CompanyName" class="form-control" />
                        <span asp-validation-for="CompanyName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CompanyEik" class="form-label"></label>
                        <input asp-for="CompanyEik" class="form-control" />
                        <span asp-validation-for="CompanyEik" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CompanyVatNumber" class="form-label"></label>
                        <input asp-for="CompanyVatNumber" class="form-control" />
                        <span asp-validation-for="CompanyVatNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="BillingAddress" class="form-label"></label>
                        <textarea asp-for="BillingAddress"
                                  class="form-control"
                                  rows="3"></textarea>
                        <span asp-validation-for="BillingAddress" class="text-danger"></span>
                    </div>

                </div>


                <div class="d-flex justify-content-between gap-3 flex-wrap">

                    <a asp-controller="ShoppingCart" asp-action="Index" class="btn btn-outline-secondary">
                        ← Обратно към количката
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Потвърди поръчката
                    </button>

                </div>

            </form>

        </div>
    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const customerType = document.getElementById("CustomerType");
        const companyFields = document.getElementById("companyInvoiceFields");

        function updateCompanyFields() {
            companyFields.hidden = customerType.value !== "Company";
        }

        customerType.addEventListener("change", updateCompanyFields);
        updateCompanyFields();
    });
</script>
