@model ChainMarket.Web.Models.ChainProduct

@{
    ViewData["Title"] = "Добавяне на машинна верига";
}

<h2>Добавяне на машинна верига</h2>

<form asp-controller="ChainProducts" asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Наименование</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>



    <div class="mb-3">
        <label asp-for="ChainStandardId" class="form-label">Стандарт</label>
        <select asp-for="ChainStandardId" class="form-select">
            <option value="">-- Изберете стандарт --</option>
            @foreach (var standard in ViewBag.Standards)
            {
                <option value="@standard.Id">@standard.Code</option>
            }
        </select>
        <span asp-validation-for="ChainStandardId" class="text-danger"></span>
    </div>



    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Категория</label>
        <select asp-for="CategoryId" class="form-select">
            <option value="0">-- Изберете категория --</option>
            @foreach (var category in ViewBag.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>




    <div class="mb-3">
        <label asp-for="ChainNomenclatureId" class="form-label">
            Номенклатура
        </label>
        <select asp-for="ChainNomenclatureId" class="form-select">
            <option value="">-- Изберете номенклатура --</option>
            @foreach (var item in ViewBag.Nomenclatures)
            {
                <option value="@item.Id"
                        data-category-id="@item.CategoryId">
                    @item.Code
                </option>
            }
        </select>
        <span asp-validation-for="ChainNomenclatureId"
              class="text-danger"></span>
    </div>



    <div class="mb-3">
        <label asp-for="ChainCode" class="form-label">Код на веригата</label>
        <input asp-for="ChainCode" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Запази
    </button>
</form>



<script>
    document.addEventListener("DOMContentLoaded", function () {
        const categorySelect = document.getElementById("CategoryId");
        const nomenclatureSelect = document.getElementById("ChainNomenclatureId");

        function filterNomenclatures() {
            const selectedCategory = categorySelect.value;

            for (const option of nomenclatureSelect.options) {
                if (!option.value) {
                    option.hidden = false;
                    continue;
                }

                option.hidden =
                    option.dataset.categoryId !== selectedCategory;
            }

            const selectedOption =
                nomenclatureSelect.options[nomenclatureSelect.selectedIndex];

            if (selectedOption && selectedOption.hidden) {
                nomenclatureSelect.value = "";
            }
        }

        categorySelect.addEventListener("change", filterNomenclatures);
        filterNomenclatures();
    });
</script>