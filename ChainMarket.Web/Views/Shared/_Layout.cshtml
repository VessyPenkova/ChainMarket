<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChainMarket</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChainMarket.Web.styles.css" asp-append-version="true" />
</head>
<body class="chainmarket-page">

    <header class="chainmarket-header">
        <nav class="navbar navbar-expand-lg chainmarket-navbar">
            <div class="container">

                <a class="navbar-brand chainmarket-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    CHAIN<span>MARKET</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#chainmarketNavigation"
                        aria-controls="chainmarketNavigation"
                        aria-expanded="false"
                        aria-label="Отвори менюто">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="chainmarketNavigation">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Начало
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="ChainProducts"
                               asp-action="Index">
                                Машинни вериги
                            </a>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <div class="chainmarket-content">
        <div class="container">
            <main role="main" class="chainmarket-main">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="chainmarket-footer">
        <div class="container">

            <div class="chainmarket-footer-content">

                <span>
                    &copy; @DateTime.Now.Year ChainMarket
                </span>

                <span>
                    Created by
                    <strong class="chainmarket-developer">
                        Vessy Penkova
                    </strong>
                </span>

            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>